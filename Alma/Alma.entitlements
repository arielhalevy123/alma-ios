<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for Sign in with Apple. App Store guideline 4.8 makes this
	     mandatory once the app offers any third-party sign-in, which it does
	     (Google). Enabling the capability needs a paid developer account; the
	     simulator build works without one. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
